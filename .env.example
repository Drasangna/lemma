# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# Required. Get a key at https://openrouter.ai/keys — this single key
# reaches every model provider (OpenAI, DeepSeek, Anthropic, etc.) through
# OpenRouter's gateway.
OPENROUTER_API_KEY=

# Optional. Identifies this app politely to Crossref's API when searching
# the literature. Use your own email address.
CROSSREF_MAILTO=

# Optional. Path to the local SQLite database file. Defaults to ./data/lemma.db.
LEMMA_DB_PATH=
